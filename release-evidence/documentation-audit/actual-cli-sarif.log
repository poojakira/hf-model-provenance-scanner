{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "hf-scanner",
          "version": "0.3.0",
          "informationUri": "https://github.com/hf-scanner",
          "rules": [
            {
              "id": "HFS-001",
              "name": "powershell-subprocess",
              "shortDescription": {
                "text": "High-risk execution/deserialization callable, execution from __init__.py, or command referencing powershell, cmd.exe, or pwsh"
              },
              "helpUri": "https://github.com/hf-scanner/rules#HFS-001",
              "properties": {
                "tags": [
                  "loader",
                  "execution"
                ],
                "cwe": "CWE-78"
              }
            },
            {
              "id": "HFS-002",
              "name": "ssl-verification-disabled",
              "shortDescription": {
                "text": "verify=False, ssl._create_unverified_context, check_hostname=False, or CERT_NONE TLS policy"
              },
              "helpUri": "https://github.com/hf-scanner/rules#HFS-002",
              "properties": {
                "tags": [
                  "network",
                  "ssl"
                ],
                "cwe": "CWE-295"
              }
            },
            {
              "id": "HFS-003",
              "name": "base64-decoded-payload-executes",
              "shortDescription": {
                "text": "base64 string decoded and result passed to exec, eval, subprocess, or os.system"
              },
              "helpUri": "https://github.com/hf-scanner/rules#HFS-003",
              "properties": {
                "tags": [
                  "obfuscation",
                  "execution"
                ],
                "cwe": "CWE-94"
              }
            },
            {
              "id": "HFS-004",
              "name": "paste-service-c2",
              "shortDescription": {
                "text": "network call to known paste/dead-drop or attacker infrastructure domains"
              },
              "helpUri": "https://github.com/hf-scanner/rules#HFS-004",
              "properties": {
                "tags": [
                  "network",
                  "c2"
                ],
                "cwe": "CWE-506"
              }
            },
            {
              "id": "HFS-005",
              "name": "dynamic-powershell-in-shell",
              "shortDescription": {
                "text": ".bat or .ps1 file containing powershell + -EncodedCommand or -enc"
              },
              "helpUri": "https://github.com/hf-scanner/rules#HFS-005",
              "properties": {
                "tags": [
                  "loader",
                  "shell"
                ],
                "cwe": "CWE-78"
              }
            },
            {
              "id": "HFS-006",
              "name": "amsi-etw-disable",
              "shortDescription": {
                "text": "AMSI, ETW, or process-mitigation bypass strings present in model code"
              },
              "helpUri": "https://github.com/hf-scanner/rules#HFS-006",
              "properties": {
                "tags": [
                  "evasion"
                ],
                "cwe": "CWE-693"
              }
            },
            {
              "id": "HFS-010",
              "name": "high-entropy-string",
              "shortDescription": {
                "text": "String literal with Shannon entropy >= 5.7 AND length >= 40 chars, not in allowlist"
              },
              "helpUri": "https://github.com/hf-scanner/rules#HFS-010",
              "properties": {
                "tags": [
                  "obfuscation"
                ],
                "cwe": "CWE-506"
              }
            },
            {
              "id": "HFS-011",
              "name": "dynamic-import-construction",
              "shortDescription": {
                "text": "Attribute or module name built via string concatenation"
              },
              "helpUri": "https://github.com/hf-scanner/rules#HFS-011",
              "properties": {
                "tags": [
                  "obfuscation"
                ],
                "cwe": "CWE-94"
              }
            },
            {
              "id": "HFS-012",
              "name": "silent-exception-swallow",
              "shortDescription": {
                "text": "except: or except Exception: pass wrapping suspicious loader behavior"
              },
              "helpUri": "https://github.com/hf-scanner/rules#HFS-012",
              "properties": {
                "tags": [
                  "evasion"
                ],
                "cwe": "CWE-390"
              }
            },
            {
              "id": "HFS-013",
              "name": "zone-identifier-removal",
              "shortDescription": {
                "text": "Zone.Identifier string in any file (Windows ADS removal)"
              },
              "helpUri": "https://github.com/hf-scanner/rules#HFS-013",
              "properties": {
                "tags": [
                  "evasion"
                ],
                "cwe": "CWE-693"
              }
            },
            {
              "id": "HFS-014",
              "name": "hidden-window-execution",
              "shortDescription": {
                "text": "CREATE_NO_WINDOW, WindowStyle Hidden, creationflags=0x08000000, or SW_HIDE in Python or shell"
              },
              "helpUri": "https://github.com/hf-scanner/rules#HFS-014",
              "properties": {
                "tags": [
                  "evasion"
                ],
                "cwe": "CWE-693"
              }
            },
            {
              "id": "HFS-015",
              "name": "defender-exclusion-add",
