              "shortDescription": {
                "text": "Org name has Levenshtein distance <= 2 from a protected org"
              },
              "helpUri": "https://github.com/hf-scanner/rules#HFS-020",
              "properties": {
                "tags": [
                  "typosquat"
                ],
                "cwe": "CWE-451"
              }
            },
            {
              "id": "HFS-021",
