                "text": "config.json or tokenizer_config.json contains a URL in a non-standard field"
              },
              "helpUri": "https://github.com/hf-scanner/rules#HFS-024",
              "properties": {
                "tags": [
                  "network"
                ],
                "cwe": "CWE-506"
              }
            },
            {
              "id": "HFS-025",
              "name": "suspicious-loader-entrypoint",
              "shortDescription": {
                "text": "Repository contains executable loader/startup files that require manual review"
              },
              "helpUri": "https://github.com/hf-scanner/rules#HFS-025",
              "properties": {
                "tags": [
                  "loader",
                  "review"
                ],
                "cwe": "CWE-506"
              }
