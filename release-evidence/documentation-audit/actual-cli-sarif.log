                "text": "Cosine similarity of model card tokens >= 0.90 vs protected org card"
              },
              "helpUri": "https://github.com/hf-scanner/rules#HFS-021",
              "properties": {
                "tags": [
                  "typosquat"
                ],
                "cwe": "CWE-451"
              }
            },
            {
              "id": "HFS-022",
              "name": "new-org-high-velocity",
              "shortDescription": {
                "text": "Org age < 72 hours AND download count > 10,000"
              },
              "helpUri": "https://github.com/hf-scanner/rules#HFS-022",
              "properties": {
                "tags": [
                  "anomaly"
                ],
                "cwe": "CWE-693"
              }
            },
            {
              "id": "HFS-023",
              "name": "suspicious-network-in-loader",
              "shortDescription": {
                "text": "Network call inside loader, setup, install, or startup model code"
