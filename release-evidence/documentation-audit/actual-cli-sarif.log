                "text": "Windows Defender exclusion or preference manipulation in model code"
              },
              "helpUri": "https://github.com/hf-scanner/rules#HFS-015",
              "properties": {
                "tags": [
                  "evasion"
                ],
                "cwe": "CWE-693"
              }
            },
            {
              "id": "HFS-016",
              "name": "scheduled-task-persistence",
              "shortDescription": {
                "text": "Scheduled task or startup persistence command in model code"
              },
              "helpUri": "https://github.com/hf-scanner/rules#HFS-016",
              "properties": {
                "tags": [
                  "persistence",
                  "evasion"
                ],
                "cwe": "CWE-693"
              }
            },
            {
