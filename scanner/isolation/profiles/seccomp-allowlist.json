        "getcwd", "readlink", "readlinkat", "openat", "newfstatat",
        "clock_gettime", "clock_nanosleep", "gettimeofday", "futex",
        "set_robust_list", "get_robust_list", "set_tid_address",
        "arch_prctl", "prlimit64", "getrandom", "sysinfo", "poll", "ppoll",
