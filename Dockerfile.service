FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY pyproject.toml README.md ./
COPY scanner ./scanner

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir ".[service]"

RUN useradd --create-home --uid 10001 scanner \
    && chown -R scanner:scanner /app
USER scanner

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/health', timeout=3).read()" || exit 1

CMD ["uvicorn", "scanner.service:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1", "--no-access-log"]
